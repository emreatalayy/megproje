<%
  // seo: { title, description, url, image, type, keywords, noindex, jsonLd, publishedTime, modifiedTime }
  var s = typeof seo !== "undefined" ? seo : {};
  var pageTitle = s.title || site.meta.title;
  var pageDesc = s.description || site.meta.description;
  var pageUrl = s.url || site.meta.siteUrl;
  var pageImage = s.image || site.meta.ogImage;
  var pageType = s.type || "website";
%>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
<title><%= pageTitle %></title>
<meta name="description" content="<%= pageDesc %>" />
<meta name="keywords" content="<%= s.keywords || site.meta.keywords %>" />
<meta name="author" content="<%= site.meta.organization.name %>" />
<% if (s.noindex) { %><meta name="robots" content="noindex, nofollow" /><% } else { %><meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" /><% } %>
<link rel="canonical" href="<%= pageUrl %>" />
<meta name="theme-color" content="#1c1917" />

<!-- Yerel SEO: coğrafi konum -->
<meta name="geo.region" content="TR-42" />
<meta name="geo.placename" content="Konya" />
<meta name="geo.position" content="<%= site.meta.organization.geo.lat %>;<%= site.meta.organization.geo.lng %>" />
<meta name="ICBM" content="<%= site.meta.organization.geo.lat %>, <%= site.meta.organization.geo.lng %>" />

<!-- Open Graph -->
<meta property="og:type" content="<%= pageType %>" />
<meta property="og:site_name" content="<%= site.meta.organization.name %>" />
<meta property="og:locale" content="<%= site.meta.locale %>" />
<meta property="og:title" content="<%= pageTitle %>" />
<meta property="og:description" content="<%= pageDesc %>" />
<meta property="og:url" content="<%= pageUrl %>" />
<meta property="og:image" content="<%= pageImage %>" />
<% if (pageType === "article") { %>
  <% if (s.publishedTime) { %><meta property="article:published_time" content="<%= s.publishedTime %>" /><% } %>
  <% if (s.modifiedTime) { %><meta property="article:modified_time" content="<%= s.modifiedTime %>" /><% } %>
<% } %>

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="<%= pageTitle %>" />
<meta name="twitter:description" content="<%= pageDesc %>" />
<meta name="twitter:image" content="<%= pageImage %>" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="/css/main.css?v=12" />

<!-- JSON-LD yapısal veri: yerel işletme / mimarlık ofisi -->
<script type="application/ld+json">
<%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": ["Architect", "ProfessionalService", "LocalBusiness"],
  "@id": site.meta.siteUrl + "/#organization",
  "name": site.meta.organization.name,
  "legalName": site.meta.organization.legalName,
  "description": site.meta.description,
  "url": site.meta.siteUrl,
  "logo": site.meta.ogImage,
  "image": site.meta.ogImage,
  "foundingDate": site.meta.organization.foundingDate,
  "priceRange": site.meta.organization.priceRange,
  "email": site.contact.email,
  "telephone": site.contact.phoneHref,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": site.contact.address.line1,
    "addressLocality": "Selçuklu",
    "addressRegion": "Konya",
    "postalCode": "42100",
    "addressCountry": "TR"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": site.meta.organization.geo.lat,
    "longitude": site.meta.organization.geo.lng
  },
  "hasMap": site.contact.map.openUrl,
  "areaServed": site.meta.organization.areaServed.map(function (a) {
    return { "@type": "City", "name": a };
  }),
  "openingHoursSpecification": [{
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
    "opens": "09:00",
    "closes": "18:00"
  }, {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": "Saturday",
    "opens": "10:00",
    "closes": "16:00"
  }],
  "knowsAbout": site.meta.organization.services,
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Mimarlık Hizmetleri",
    "itemListElement": site.meta.organization.services.map(function (svc) {
      return { "@type": "Offer", "itemOffered": { "@type": "Service", "name": svc, "areaServed": "Konya" } };
    })
  },
  "sameAs": site.footer.social.map(function (x) { return x.href; })
}) %>
</script>
<% if (s.jsonLd) { %>
<script type="application/ld+json"><%- JSON.stringify(s.jsonLd) %></script>
<% } %>
<% if (s.breadcrumb) { %>
<script type="application/ld+json"><%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": s.breadcrumb.map(function (b, i) {
    return { "@type": "ListItem", "position": i + 1, "name": b.name, "item": b.url };
  })
}) %></script>
<% } %>
