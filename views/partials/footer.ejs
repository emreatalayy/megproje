<a
  class="wa-fab interactive"
  href="https://wa.me/<%= site.contact.phoneHref.replace(/[^0-9]/g, '') %>?text=<%= encodeURIComponent('Merhaba, MEG Mimarlık ile bir proje hakkında görüşmek istiyorum.') %>"
  target="_blank"
  rel="noopener noreferrer"
  aria-label="WhatsApp'tan yazın"
>
