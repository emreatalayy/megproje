<!DOCTYPE html>
<html lang="tr">
<head>
  <%- include('partials/head', { site: site, seo: seo }) %>
</head>
<body>
  <%- include('partials/preloader') %>
  <%- include('partials/cursor') %>
  <%- include('partials/nav') %>

  <main>
    <section class="hero page-section" id="hero" aria-label="Giriş" data-section="hero">
      <div class="hero__deco" aria-hidden="true"><%= site.hero.decoChar %></div>
      <div class="hero__geo" aria-hidden="true"></div>
      <div class="hero__content">
        <p class="hero__eyebrow eyebrow"><%= site.hero.eyebrow %></p>
        <h1 class="hero__title">
          <% site.hero.titleLines.forEach(function (line, i) { %>
            <span>
              <% if (i === site.hero.titleItalicIndex) { %>
                <em><%= line %></em>
              <% } else { %>
                <%= line %>
              <% } %>
            </span>
          <% }); %>
        </h1>
        <p class="hero__subtitle"><%= site.hero.subtitle %></p>
      </div>
      <div class="hero__scroll" aria-hidden="true">
        <span class="hero__scroll-text">Aşağı Kaydır</span>
        <span class="hero__scroll-line"></span>
      </div>
    </section>

    <div class="marquee" aria-hidden="true">
      <div class="marquee__track">
        <% for (let copy = 0; copy < 2; copy++) { %>
          <div class="marquee__content"<%= copy === 1 ? ' aria-hidden="true"' : '' %>>
            <% site.marquee.forEach(function (item, i) { %>
              <span><%= item %></span><% if (i < site.marquee.length - 1) { %><span>·</span><% } %>
            <% }); %><span>·</span>
          </div>
        <% } %>
      </div>
    </div>

    <section class="section projects page-section" id="projects" aria-labelledby="projects-heading" data-section="projects">
      <div class="section-header reveal">
        <div class="section-header__left reveal reveal-delay-1">
          <p class="section-label"><%= site.projects.label %></p>
          <h2 class="section-title" id="projects-heading"><%= site.projects.title %></h2>
        </div>
        <a href="#contact" class="section-link reveal reveal-delay-2 interactive"><%= site.projects.cta %></a>
      </div>

      <p class="pacman-hint eyebrow reveal"><%= site.projects.scrollHint %></p>

      <div class="pacman-scroll" id="pacmanScroll">
        <div class="pacman-scroll__sticky">
          <div class="pacman-view" id="pacmanView">
            <div class="pacman-rail" id="pacmanRail">
              <svg class="pacman-rail__svg" viewBox="0 0 1200 360" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
                <defs>
                  <mask id="pacmanEatMask" maskUnits="userSpaceOnUse" x="0" y="0" width="1200" height="360">
                    <path
                      id="pacmanEatMaskPath"
                      d="M 40 180 Q 180 80 320 180 Q 460 280 600 180 Q 740 80 880 180 Q 1020 280 1160 180"
                      pathLength="1"
                      fill="none"
                      stroke="#ffffff"
                      stroke-width="40"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-dasharray="1 1"
                      stroke-dashoffset="0"
                    />
                  </mask>
                </defs>
                <path
                  id="pacmanPath"
                  d="M 40 180 Q 180 80 320 180 Q 460 280 600 180 Q 740 80 880 180 Q 1020 280 1160 180"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="5"
                  stroke-dasharray="0.1 24"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  mask="url(#pacmanEatMask)"
                />
              </svg>

              <div class="pacman-player" id="pacmanPlayer" aria-hidden="true">
                <span class="pacman-player__body"></span>
              </div>

              <div class="pacman-ghost" id="pacmanGhost" aria-hidden="true">
                <svg viewBox="0 0 100 100" aria-hidden="true">
                  <path class="pacman-ghost__body" d="M8 92 V46 C8 24 26 8 50 8 C74 8 92 24 92 46 V92 L80 82 L68 92 L56 82 L44 92 L32 82 L20 92 Z" />
                  <circle class="pacman-ghost__eye" cx="38" cy="44" r="9" />
                  <circle class="pacman-ghost__eye" cx="64" cy="44" r="9" />
                  <circle class="pacman-ghost__pupil" cx="41" cy="46" r="4" />
                  <circle class="pacman-ghost__pupil" cx="67" cy="46" r="4" />
                </svg>
              </div>

              <% projects.forEach(function (p, i) { %>
                <div class="pacman-node pacman-node--<%= p.side %>" data-node="<%= i %>">
                  <span class="pacman-node__pellet" aria-hidden="true"></span>
                  <span class="pacman-node__link" aria-hidden="true"></span>
                  <a href="<%= p.slug ? ('/projeler/' + p.slug) : '#contact' %>" class="pacman-node__seat interactive" title="<%= p.name %>">
                    <span class="pacman-node__no"><%= p.id %></span>
                    <span class="pacman-node__name"><%= p.name %></span>
                  </a>
                </div>
              <% }); %>
            </div>

            <div class="pacman-win" id="pacmanWin" aria-hidden="true">
              <div class="pacman-win__inner">
                <span class="pacman-win__pac" aria-hidden="true"></span>
                <p class="pacman-win__stage">STAGE CLEAR</p>
                <p class="pacman-win__title">Tebrikler, tüm projeleri keşfettin!</p>
                <p class="pacman-win__sub">Sıradaki proje seninki olsun.</p>
                <a href="#contact" class="pacman-win__cta interactive">Projeni başlatalım →</a>
              </div>
            </div>
          </div>
          <div class="pacman-scroll__bar" aria-hidden="true">
            <span class="pacman-scroll__fill" id="pacmanScrollFill"></span>
          </div>
        </div>
      </div>
    </section>

    <%- include('partials/motif', { tone: 'light' }) %>

    <section class="section about page-section reveal" id="about" aria-labelledby="about-heading" data-section="about">
      <div class="about-grid">
        <blockquote class="about__statement reveal reveal-delay-1"><%- site.about.statement %></blockquote>
        <div class="about__body reveal reveal-delay-2">
          <% site.about.paragraphs.forEach(function (para) { %>
            <p><%= para %></p>
          <% }); %>
        </div>
      </div>
    </section>

    <section class="section services page-section reveal" id="services" aria-labelledby="services-heading" data-section="services">
      <div class="services-intro">
        <div class="reveal reveal-delay-1">
          <p class="section-label"><%= site.services.label %></p>
          <h2 class="section-title" id="services-heading"><%= site.services.title %></h2>
        </div>
        <p class="reveal reveal-delay-2"><%= site.services.intro %></p>
      </div>
      <div class="services-grid" data-draw data-wheel role="list" aria-label="<%= site.services.title %>">
        <% site.services.items.forEach(function (svc, i) { %>
          <article class="service-card" role="listitem" style="--i: <%= i %>">
            <span class="service-card__badge" aria-hidden="true">
              <svg viewBox="0 0 36 36" focusable="false">
                <rect x="6" y="6" width="24" height="24" />
                <rect x="6" y="6" width="24" height="24" transform="rotate(45 18 18)" />
              </svg>
              <span><%= svc.no %></span>
            </span>
            <h3 class="service-card__name"><%= svc.name %></h3>
            <p class="service-card__desc"><%= svc.desc %></p>
          </article>
        <% }); %>
      </div>
    </section>

    <%- include('partials/motif', { tone: 'dark' }) %>

    <%# Koyu blok motif bantlarına bitişik: bölümün kendisi reveal ile kaymamalı
        (kayınca bantla arasında krem şerit açılıyor); yalnızca içindeki yazı belirir. %>
    <section class="philosophy page-section" aria-label="Felsefe" data-section="philosophy">
      <span class="philosophy__quote-mark" aria-hidden="true">"</span>
      <blockquote class="philosophy__text reveal reveal-delay-1"><%= site.philosophy.quote %></blockquote>
      <p class="philosophy__attr reveal reveal-delay-2"><%= site.philosophy.attribution %></p>
    </section>

    <%- include('partials/motif', { tone: 'dark' }) %>

    <section class="section contact page-section reveal" id="contact" aria-labelledby="contact-heading" data-section="contact">
      <div class="contact-head reveal reveal-delay-1">
        <p class="section-label">İletişim</p>
        <h2 class="contact__title" id="contact-heading"><%= site.contact.title %></h2>
      </div>

      <div class="contact-grid">
        <div class="contact-info">
          <dl class="contact-sheet reveal reveal-delay-1">
            <div class="contact-sheet__row">
              <dt>Adres</dt>
              <dd><%= site.contact.address.line1 %>, <%= site.contact.address.line2 %></dd>
            </div>
            <div class="contact-sheet__row">
              <dt>E-posta</dt>
              <dd><a href="mailto:<%= site.contact.email %>" class="interactive"><%= site.contact.email %></a></dd>
            </div>
            <div class="contact-sheet__row">
              <dt>Telefon</dt>
              <dd><a href="tel:<%= site.contact.phoneHref %>" class="interactive"><%= site.contact.phone %></a></dd>
            </div>
            <div class="contact-sheet__row">
              <dt>Saatler</dt>
              <dd><%= site.contact.hours %></dd>
            </div>
          </dl>

          <figure class="contact-plan reveal reveal-delay-2" data-draw>
            <svg viewBox="0 0 600 300" role="img" aria-label="Ofis konumunu gösteren şematik vaziyet planı: <%= site.contact.address.full %>">
              <g class="plan-lots">
                <path class="plan-lot" style="--d: 0s" d="M30 30H180V120H30Z" />
                <path class="plan-lot" style="--d: .08s" d="M290 20H420V80H290Z" />
                <path class="plan-lot" style="--d: .16s" d="M450 15H580V95H450Z" />
                <path class="plan-lot" style="--d: .32s" d="M20 225H190V280H20Z" />
                <path class="plan-lot" style="--d: .4s" d="M300 200H450V270H300Z" />
                <path class="plan-lot" style="--d: .48s" d="M480 185H580V270H480Z" />
              </g>
              <g class="plan-roads">
                <path class="plan-road" pathLength="1" d="M0 170L600 120" />
                <path class="plan-road" pathLength="1" d="M0 204L600 154" />
                <path class="plan-road" pathLength="1" d="M215 0L255 300" />
                <path class="plan-road" pathLength="1" d="M247 0L287 300" />
              </g>
              <text class="plan-label" x="56" y="190" transform="rotate(-4.76 56 190)">ULUYAYLA CD.</text>
              <g class="plan-pin">
                <path class="plan-office" d="M306 140L346 136.7V100H306Z" />
                <circle class="plan-ring" cx="326" cy="120" r="30" />
                <text class="plan-label plan-label--pin" x="364" y="118">MEG · No:52 A</text>
              </g>
              <g class="plan-north">
                <path d="M560 266V234M560 234L552 250M560 234L568 250" />
                <text class="plan-label" x="555" y="226">K</text>
              </g>
            </svg>
            <figcaption>
              <span>Vaziyet · Selçuklu</span>
              <span class="contact-plan__links">
                <a href="<%= site.contact.map.openUrl %>" class="interactive" target="_blank" rel="noopener noreferrer">Haritada aç</a>
                <a href="<%= site.contact.map.directionsUrl %>" class="interactive" target="_blank" rel="noopener noreferrer">Yol tarifi al ↗</a>
              </span>
            </figcaption>
          </figure>
        </div>

        <form class="contact__form reveal reveal-delay-2" id="contactForm" novalidate>
          <div class="form-group">
            <label class="form-label" for="name">Ad Soyad</label>
            <input class="form-input interactive" type="text" id="name" name="name" autocomplete="name" required />
          </div>
          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="email">E-posta</label>
              <input class="form-input interactive" type="email" id="email" name="email" autocomplete="email" required />
            </div>
            <div class="form-group">
              <label class="form-label" for="phone">Telefon (isteğe bağlı)</label>
              <input class="form-input interactive" type="tel" id="phone" name="phone" autocomplete="tel" inputmode="tel" />
            </div>
          </div>
          <fieldset class="form-group form-choice">
            <legend class="form-label">Proje türü</legend>
            <div class="form-segment">
              <% site.contact.projectTypes.forEach(function (type, i) { %>
                <label class="form-segment__opt interactive">
                  <input type="radio" name="projectType" value="<%= type %>"<%= i === 0 ? ' checked' : '' %> />
                  <span><%= type %></span>
                </label>
              <% }); %>
            </div>
          </fieldset>
          <div class="form-group">
            <label class="form-label" for="message">Proje hakkında</label>
            <textarea class="form-textarea interactive" id="message" name="message" rows="4" required></textarea>
          </div>
          <p class="form-status" id="formStatus" role="status" aria-live="polite" hidden></p>
          <button type="submit" class="form-submit interactive">
            <span>Gönder</span>
            <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M2 8H13M9 4L13 8L9 12" /></svg>
          </button>
        </form>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>

  <script>
    window.MEG_SITE = { contactEmail: "<%= site.contact.email %>" };
  </script>
  <script src="/vendor/lenis.min.js?v=1"></script>
  <script src="/js/main.js?v=18"></script>
</body>
</html>
