# ----------------------------------------------------------------------------
# MEG Mimarlık — Ortam Değişkenleri
# Bu dosyayı ".env" olarak kopyalayın ve değerleri doldurun.
# .env dosyası git'e gönderilmez (.gitignore'da).
# ----------------------------------------------------------------------------

# Sunucu portu (yerel geliştirme)
PORT=3000

# Sitenin kök adresi (SEO / sitemap / canonical için). Sonunda / olmasın.
SITE_URL=https://www.megmimarlik.net

# ---- Admin Girişi ----
# Birden fazla kullanıcı: "kullanici:sifre" çiftleri virgülle ayrılır.
ADMIN_USERS=kullanici1:sifre1,kullanici2:sifre2
# (Alternatif tek kullanıcı: ADMIN_USERNAME ve ADMIN_PASSWORD de kullanılabilir.)
# Oturum cookie'sini imzalamak için uzun rastgele bir dize.
# Üretmek için: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=buraya-uzun-rastgele-bir-deger

# ---- Firebase (Firestore + Storage) ----
# Firebase Console > Proje Ayarları > Hizmet hesapları > Yeni özel anahtar üret
# indirdiğiniz JSON içindeki değerleri buraya yazın.
FIREBASE_PROJECT_ID=proje-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@proje-id.iam.gserviceaccount.com
# private_key'i çift tırnak içinde, satır sonları \n olacak şekilde tek satırda yapıştırın.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# Storage kovası (Firebase Console > Storage). Yeni projelerde proje-id.firebasestorage.app
FIREBASE_STORAGE_BUCKET=proje-id.firebasestorage.app

# ---- E-posta (iletişim formu → SMTP) ----
# Gmail/Google Workspace için: 2 Adımlı Doğrulama açın, "Uygulama şifresi" üretin.
# SMTP_USER, uygulama şifresinin ait olduğu hesabın TAM e-posta adresi olmalı.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@megproje.net
SMTP_PASS="uygulama sifresi xxxx xxxx"
CONTACT_TO=info@megproje.net
CONTACT_FROM="MEG Mimarlık Web <info@megproje.net>"
